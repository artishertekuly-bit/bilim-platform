{
  "chars_per_token": 2.5,
  "embedding_timeout_s": 30,
  "providers": {
    "primary": {
      "type": "openai_compat",
      "api_key_env": "OPENAI_API_KEY",
      "base_url_env": "OPENAI_BASE_URL",
      "structured_outputs": "json_schema"
    },
    "reserve": {
      "type": "openai_compat",
      "api_key_env": "LLM_RESERVE_API_KEY",
      "base_url_env": "LLM_RESERVE_BASE_URL",
      "structured_outputs": "json_object",
      "max_tokens_param": "max_tokens"
    }
  },
  "models": {
    "small": {
      "provider": "primary",
      "model": "${LLM_SMALL_MODEL:-gpt-5.4-mini}",
      "rpm": 500,
      "tpm": 200000,
      "max_concurrency": 16,
      "pricing": { "input_per_mtok": 0.75, "cached_input_per_mtok": 0.075, "output_per_mtok": 4.5, "batch_discount": 0.5 }
    },
    "strong": {
      "provider": "primary",
      "model": "${LLM_STRONG_MODEL:-gpt-5.4}",
      "rpm": 500,
      "tpm": 100000,
      "max_concurrency": 16,
      "pricing": { "input_per_mtok": 2.5, "cached_input_per_mtok": 0.25, "output_per_mtok": 15.0, "batch_discount": 0.5 }
    },
    "grading": {
      "provider": "primary",
      "model": "${LLM_GRADING_MODEL:-gpt-5.4-mini-2026-03-17}",
      "pinned": true,
      "rpm": 500,
      "tpm": 100000,
      "max_concurrency": 8,
      "pricing": { "input_per_mtok": 0.75, "cached_input_per_mtok": 0.075, "output_per_mtok": 4.5 }
    },
    "second_grading": {
      "provider": "primary",
      "model": "${LLM_SECOND_GRADING_MODEL:-gpt-5.4-2026-03-05}",
      "rpm": 200,
      "tpm": 50000,
      "max_concurrency": 4,
      "pricing": { "input_per_mtok": 2.5, "cached_input_per_mtok": 0.25, "output_per_mtok": 15.0 }
    },
    "reserve": {
      "provider": "reserve",
      "model": "${LLM_RESERVE_MODEL}",
      "rpm": 100,
      "tpm": 50000,
      "max_concurrency": 8
    },
    "answer_embedding": {
      "provider": "primary",
      "kind": "embedding",
      "model": "${LLM_ANSWER_EMBEDDING_MODEL:-text-embedding-3-small}",
      "rpm": 1000,
      "tpm": 500000,
      "max_concurrency": 8,
      "pricing": { "input_per_mtok": 0.02, "output_per_mtok": 0 }
    },
    "corpus_embedding": {
      "provider": "primary",
      "kind": "embedding",
      "model": "${LLM_CORPUS_EMBEDDING_MODEL:-text-embedding-3-large}",
      "rpm": 1000,
      "tpm": 500000,
      "max_concurrency": 8,
      "pricing": { "input_per_mtok": 0.13, "output_per_mtok": 0 }
    }
  },
  "routes": {
    "moderation": { "model": "small", "mode": "sync", "temperature": 0, "reasoning_effort": "low", "max_output_tokens": 1500, "timeout_s": 15 },
    "tutor_tags": { "model": "small", "mode": "sync", "temperature": 0, "reasoning_effort": "none", "max_output_tokens": 800, "timeout_s": 15, "fallback": ["reserve"], "prompt_cache": true },
    "mcq_solver_check": {
      "model": "small", "mode": "sync", "temperature": 0, "reasoning_effort": "low", "max_output_tokens": 2000, "timeout_s": 60, "fallback": ["reserve"],
      "variants": {
        "mcq_x3": { "reasoning_effort": "medium", "max_output_tokens": 4000 }
      }
    },
    "official_grading": { "model": "grading", "mode": "sync", "temperature": 0, "reasoning_effort": "medium", "max_output_tokens": 4000, "timeout_s": 90 },
    "second_grading": { "model": "second_grading", "mode": "sync", "temperature": 0, "reasoning_effort": "medium", "max_output_tokens": 4000, "timeout_s": 90 },
    "explanation": { "model": "small", "mode": "sync", "temperature": 0.3, "reasoning_effort": "low", "max_output_tokens": 2000, "timeout_s": 20 },
    "tutor_reply": {
      "model": "strong", "mode": "stream", "temperature": 0.7, "reasoning_effort": "none", "max_output_tokens": 1200, "timeout_s": 60, "fallback": ["reserve"], "prompt_cache": true,
      "variants": {
        "light": { "model": "small", "reasoning_effort": "none", "max_output_tokens": 700 }
      }
    },
    "examiner_dialog": { "model": "strong", "mode": "stream", "temperature": 0.3, "reasoning_effort": "low", "max_output_tokens": 3000, "timeout_s": 60 },
    "generation": {
      "model": "strong", "mode": "batch", "temperature": 0.7, "reasoning_effort": "medium", "max_output_tokens": 8000, "timeout_s": 180, "fallback": ["reserve"],
      "variants": {
        "mcq": { "model": "small", "reasoning_effort": "high" },
        "mcq_x3": { "model": "small", "reasoning_effort": "medium" },
        "matching": { "model": "strong", "reasoning_effort": "low" },
        "short_answer": { "model": "small", "reasoning_effort": "medium" },
        "true_false_fix": { "model": "small", "reasoning_effort": "medium" },
        "feynman": { "model": "small", "reasoning_effort": "medium" },
        "teach_ai": { "model": "small", "reasoning_effort": "medium" },
        "case_study": { "model": "small", "reasoning_effort": "medium" },
        "error_step": { "model": "small", "reasoning_effort": "medium" },
        "socratic": { "model": "strong", "reasoning_effort": "low" },
        "priority": { "model": "strong", "reasoning_effort": "low" }
      }
    },
    "generation_fast": {
      "model": "strong", "mode": "sync", "temperature": 0.7, "reasoning_effort": "medium", "max_output_tokens": 8000, "timeout_s": 180, "fallback": ["reserve"],
      "variants": {
        "mcq": { "model": "small", "reasoning_effort": "high" },
        "mcq_x3": { "model": "small", "reasoning_effort": "medium" },
        "matching": { "model": "strong", "reasoning_effort": "low" },
        "short_answer": { "model": "small", "reasoning_effort": "medium" },
        "true_false_fix": { "model": "small", "reasoning_effort": "medium" },
        "feynman": { "model": "small", "reasoning_effort": "medium" },
        "teach_ai": { "model": "small", "reasoning_effort": "medium" },
        "case_study": { "model": "small", "reasoning_effort": "medium" },
        "error_step": { "model": "small", "reasoning_effort": "medium" },
        "socratic": { "model": "strong", "reasoning_effort": "low" },
        "priority": { "model": "strong", "reasoning_effort": "low" },
        "game_mcq": { "model": "small", "reasoning_effort": "high" },
        "game_topic_mcq": { "model": "small", "reasoning_effort": "low", "max_output_tokens": 7000, "timeout_s": 90 },
        "game_debate": { "model": "small", "reasoning_effort": "medium" }
      }
    },
    "concept_extraction": { "model": "small", "mode": "sync", "reasoning_effort": "low", "max_output_tokens": 4000, "timeout_s": 90 },
    "game_judge": { "model": "strong", "mode": "sync", "temperature": 0.2, "reasoning_effort": "low", "max_output_tokens": 3000, "timeout_s": 60 }
  },
  "embeddings": {
    "answers": "answer_embedding",
    "questions": "answer_embedding",
    "corpus": "corpus_embedding"
  }
}
