# =========================================================
# Bilim Platform environment example
# Copy this file to .env.local for frontend local development
# and to backend/.env for backend local development.
# Never commit real API keys, service-role keys, database URLs, or JWT secrets.
# =========================================================

# -------------------------
# Frontend: Vite public env
# These values are bundled into the browser.
# Do NOT put service-role keys or private API keys here.
# -------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_AI_API_BASE_URL=https://your-backend-domain.onrender.com
VITE_AI_API_SEND_DEBUG_USER_ID=false

# -------------------------
# Backend only: server env
# Put these in backend/.env locally or in Render backend service env.
# Do NOT expose them with VITE_ prefix.
# -------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com,http://localhost:5173
APP_ENV=production
ALLOW_DEBUG_USER_ID_FALLBACK=false
