# =========================================================
# Bilim Platform environment example
# Copy this file to .env / .env.local for frontend local development
# or to backend/.env (backend automatically reads root .env and backend/.env).
# Never commit real API keys, service-role keys, database URLs, or JWT secrets.
# =========================================================

# -------------------------
# Frontend: Vite public env
# These values are bundled into the browser.
# Do NOT put service-role keys or private API keys here.
# -------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_AI_API_BASE_URL=http://localhost:8000
VITE_AI_API_SEND_DEBUG_USER_ID=false

# -------------------------
# Backend only: server env
# Backend loads from root .env and backend/.env locally, or cloud environment variables.
# Do NOT expose them with VITE_ prefix.
# -------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:8000,https://your-frontend-domain.onrender.com
APP_ENV=development

# -------------------------
# LLM gateway (backend/config/llm_gateway.json, architect/v2/api-kelisimderi.md §7)
# Model names are chosen by the measurement system (ortaq §6), not hard-coded.
# The grading model must be a dated snapshot, never a moving alias.
# -------------------------
# OPENAI_BASE_URL=
LLM_SMALL_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=
LLM_GRADING_MODEL=
LLM_SECOND_GRADING_MODEL=
LLM_ANSWER_EMBEDDING_MODEL=text-embedding-3-small
# Reserve provider: used only for Tutor and question generation (ortaq §2.4).
# It must be a DIFFERENT provider with an OpenAI-compatible API (its own key, base URL and model name).
# Leave all three empty to run without a reserve: the gateway then logs one warning per process.
LLM_RESERVE_API_KEY=
LLM_RESERVE_BASE_URL=
LLM_RESERVE_MODEL=
# LLM_GATEWAY_CONFIG=backend/config/llm_gateway.json

# -------------------------
# Examiner service database role (architect/v2/ortaq-infraqurylym.md §1)
# examiner_svc sees only the examiner schema and reads corpus. Use the Supabase pooler
# (session mode, port 5432) or a direct connection. Never commit the real password.
# -------------------------
EXAMINER_DATABASE_URL=postgresql://examiner_svc.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
