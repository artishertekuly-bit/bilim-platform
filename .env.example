# =========================================================
# Bilim Platform environment example
# Copy this file to .env / .env.local for frontend local development
# or to backend/.env (backend automatically reads root .env and backend/.env).
# Never commit real API keys, service-role keys, database URLs, or JWT secrets.
# =========================================================

# -------------------------
# Frontend: Vite public env
# These values are bundled into the browser.
# Do NOT put service-role keys or private API keys here.
# -------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_AI_API_BASE_URL=http://localhost:8000
VITE_AI_API_SEND_DEBUG_USER_ID=false

# -------------------------
# Backend only: server env
# Backend loads from root .env and backend/.env locally, or cloud environment variables.
# Do NOT expose them with VITE_ prefix.
# -------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:8000,https://your-frontend-domain.onrender.com
APP_ENV=development

# -------------------------
# Multimodal Voice AI Pipeline (Gemini 2.5 Flash + ElevenLabs)
# -------------------------
# Multimodal Audio & Brain: Google Gemini 2.5 Flash API - https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback STT & LLM: Groq API - https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
QWEN_MODEL=qwen/qwen3.8-27b

# TTS: OpenAI Audio Speech API (gpt-4o-mini-tts with coral / nova voice)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Voice options: coral (warm female), nova (energetic female), sage, alloy, onyx

# Optional ElevenLabs API fallback
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
